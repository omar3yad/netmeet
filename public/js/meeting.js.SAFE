    //handle mute all
    async function handleMuteAll(value) {
        if (value) {
            $("#toggleMic").html('<i class="fa fa-microphone-slash"></i>').attr('disabled', true);
            showSuccess(languages.mic_muted_moderator);
            if (audioMuted) return;

            localStream.getAudioTracks().forEach((track) => (track.enabled = false));

            // $(this).html('<i class="fa fa-microphone"></i>');
            // audioParams.track.stop();
            // sendMessage(socket, { type: 'producerClose', id: audioParams.id });
            localAudio.srcObject = null;

            audioMuted = allMuted = true;
            if (isRecording) mixer.resetVideoStreams(getMediaStreams());

            stopHark();
        } else {
            localStream.getAudioTracks().forEach((track) => (track.enabled = true));
            // $(this).html('<i class="fa fa-microphone-slash"></i>');

            // localAudioStream = await getUserMedia(true, false);
            // audioParams.track = localAudioStream.getTracks()[0];
            // producerTransport.produce(audioParams);
            // localAudio.srcObject = new MediaStream([audioParams.track]);

            $("#toggleMic").html('<i class="fa fa-microphone"></i>').attr('disabled', false);
            audioMuted = allMuted = false;
            showSuccess(languages.mic_unmuted_moderator);

            if (isRecording) mixer.appendStreams(new MediaStream([audioParams.track]));

            initHark();
        }
    }

    //listen on mute all click
    $(document).on('click', '#muteAll', function () {
        if (!isModerator) return;

        if (allMuted) {
            sendMessage(socket, {
                type: 'muteAll',
                value: false,
                meetingId: userInfo.meetingId,
            });
            allMuted = false;
            $("#muteAll").html('<i class="fa fa-users"></i>');
            showInfo(languages.you_unmuted);
        } else {
            sendMessage(socket, {
                type: 'muteAll',
                value: true,
                meetingId: userInfo.meetingId,
            });
            allMuted = true;
            $("#muteAll").html('<i class="fa fa-users-slash"></i>');
            showInfo(languages.you_muted);
        }
    });

    // Copy meeting link functionality
    $(document).on('click', '#copyMeetingLink', function () {
        const meetingLink = window.location.href;
        
        if (navigator.clipboard && window.isSecureContext) {
            // Use modern clipboard API
            navigator.clipboard.writeText(meetingLink).then(function() {
                showSuccess('Meeting link copied to clipboard!');
            }).catch(function(err) {
                console.error('Could not copy text: ', err);
                fallbackCopyTextToClipboard(meetingLink);
            });
        } else {
            // Fallback for older browsers
            fallbackCopyTextToClipboard(meetingLink);
        }
    });

    // Fallback copy function for older browsers
    function fallbackCopyTextToClipboard(text) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        
        try {
            const successful = document.execCommand('copy');
            if (successful) {
                showSuccess('Meeting link copied to clipboard!');
            } else {
                showError('Failed to copy meeting link');
            }
        } catch (err) {
            console.error('Fallback: Oops, unable to copy', err);
            showError('Failed to copy meeting link');
        }
        
        document.body.removeChild(textArea);
    }

    // Picture-in-Picture functionality
    let pipWindow = null;
    let pipVideo = null;
    let isPipActive = false;
    let pipControls = null;
    let pipVisibilityCheckInterval = null;

    // Initialize Picture-in-Picture
    function initializePictureInPicture() {
        // Check if Picture-in-Picture is supported
        if (!document.pictureInPictureEnabled && !document.webkitSupportsPresentationMode) {
            console.log('Picture-in-Picture not supported');
            return;
        }

        // Create floating video element for PiP
        createPipVideoElement();
        
        // Add visibility change listener for automatic PiP
        document.addEventListener('visibilitychange', handleVisibilityChange);
        
        // Add page focus/blur listeners
        window.addEventListener('blur', handlePageBlur);
        window.addEventListener('focus', handlePageFocus);
        
        // Add beforeunload listener to clean up PiP
        window.addEventListener('beforeunload', cleanupPip);
        
        console.log('Picture-in-Picture initialized');
    }

    // Handle visibility change (tab switching)
    function handleVisibilityChange() {
        if (document.hidden ) {
            // Page is hidden (tab switched or minimized) - show PiP for host only
            if (!isPipActive) {
                startPictureInPicture();
            }
        } else if (!document.hidden) {
            // Page is visible - hide PiP
            if (isPipActive) {
                hidePipWindow();
            }
        }
    }

    // Handle page blur (browser minimized)
    function handlePageBlur() {
        // Small delay to check if it's actually minimized
        setTimeout(() => {
            if (document.hidden && !isPipActive) {
                startPictureInPicture();
            }
        }, 100);
    }

    // Handle page focus (browser restored)
    function handlePageFocus() {
        if (isPipActive) {
            hidePipWindow();
        }
    }

    // Create floating video element for PiP
    function createPipVideoElement() {
        // Remove existing PiP video if any
        if (pipVideo) {
            pipVideo.remove();
        }
        if (pipControls) {
            pipControls.remove();
        }

        // Create new PiP video element
        pipVideo = document.createElement('video');
        pipVideo.id = 'pip-video';
        pipVideo.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            width: 320px;
            height: 240px;
            background: #000;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            z-index: 9999;
            display: none;
            cursor: pointer;
            border: 2px solid #e0e0e0;
        `;

        // Create PiP controls
        pipControls = document.createElement('div');
        pipControls.id = 'pip-controls';
        pipControls.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            width: 320px;
            height: 240px;
            z-index: 10000;
            display: none;
            pointer-events: none;
        `;

        // Create control buttons
        const backToTabBtn = document.createElement('button');
        backToTabBtn.innerHTML = '<i class="fa fa-arrow-left"></i> ' + languages.back_to_tab;
        backToTabBtn.style.cssText = `
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.8);
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
            pointer-events: auto;
            transition: all 0.3s ease;
        `;
        backToTabBtn.onclick = maximizeFromPip;

        const cameraBtn = document.createElement('button');
        cameraBtn.innerHTML = '<i class="fa fa-video"></i>';
        cameraBtn.style.cssText = `
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0,0,0,0.8);
            color: white;
            border: none;
            padding: 8px;
            border-radius: 50%;
            font-size: 12px;
            cursor: pointer;
            pointer-events: auto;
            transition: all 0.3s ease;
            width: 32px;
            height: 32px;
        `;
        cameraBtn.onclick = togglePipCamera;

        const micBtn = document.createElement('button');
        micBtn.innerHTML = '<i class="fa fa-microphone"></i>';
        micBtn.style.cssText = `
            position: absolute;
            top: 50px;
            right: 10px;
            background: rgba(0,0,0,0.8);
            color: white;
            border: none;
            padding: 8px;
            border-radius: 50%;
            font-size: 12px;
            cursor: pointer;
            pointer-events: auto;
            transition: all 0.3s ease;
            width: 32px;
            height: 32px;
        `;
        micBtn.onclick = togglePipMic;

        // Add controls to container
        pipControls.appendChild(backToTabBtn);
        pipControls.appendChild(cameraBtn);
        pipControls.appendChild(micBtn);

        // Add event listeners
        pipVideo.addEventListener('click', maximizeFromPip);
        
        // Add to DOM
        document.body.appendChild(pipVideo);
        document.body.appendChild(pipControls);
        
        // Update video source
        updatePipVideoSource();
    }

    // Maximize from PiP
    function maximizeFromPip() {
        if (!isPipActive) return;
        
        // Hide PiP
        hidePipWindow();
        
        // Focus the window
        window.focus();
        
        // Scroll to meeting area
        const meetingArea = document.querySelector('#videos') || document.querySelector('.meeting-container');
        if (meetingArea) {
            meetingArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        
        console.log('Maximized from PiP');
    }

    // Clean up PiP
    function cleanupPip() {
        // Stop visibility check
        stopPipVisibilityCheck();
        
        if (pipVideo) {
            pipVideo.remove();
            pipVideo = null;
        }
        
        if (pipControls) {
            pipControls.remove();
            pipControls = null;
        }
        
        if (pipWindow) {
            pipWindow.close();
            pipWindow = null;
        }
        
        isPipActive = false;
        
        // Remove event listener
        window.removeEventListener('beforeunload', cleanupPip);
    }

    // Enhanced Picture-in-Picture with native API support
    async function startNativePictureInPicture() {
        if (!document.pictureInPictureEnabled) {
            console.log('Native PiP not supported, using custom PiP');
            return false;
        }
        
        try {
            const mainVideo = document.querySelector('#selfContainer video') || 
                             document.querySelector('.videoContainer:not(#selfContainer) video') ||
                             document.querySelector('.screen-share-container video');
            
            if (!mainVideo) {
                console.log('No video element found for PiP');
                return false;
            }
            
            if (document.pictureInPictureElement) {
                await document.exitPictureInPicture();
            }
            
            await mainVideo.requestPictureInPicture();
            console.log('Native PiP started');
            return true;
        } catch (error) {
            console.error('Native PiP failed:', error);
            return false;
        }
    }

    // Stop native Picture-in-Picture
    async function stopNativePictureInPicture() {
        if (document.pictureInPictureElement) {
            try {
                await document.exitPictureInPicture();
                console.log('Native PiP stopped');
            } catch (error) {
                console.error('Failed to stop native PiP:', error);
            }
        }
    }

    // Picture-in-Picture button handler
    $(document).on('click', '#pictureInPicture', function () {
        if (!isModerator && settings.authMode !== "disabled" && settings.moderatorRights !== "disabled") {
            showError(languages.pip_host_only);
            return;
        }

        if (isPipActive) {
            // Return to meeting
            maximizeFromPip();
            $(this).removeClass('active').html('<i class="fa fa-external-link-alt"></i>');
        } else {
            // Start Picture-in-Picture
            startPictureInPicture();
            // Button state will be updated by startPictureInPicture function
        }
    });

    // Update PiP video source
    function updatePipVideoSource() {
        if (!pipVideo) return;
        
        console.log('Updating PiP video source...');
        
        // Try to get the main meeting video - prioritize screen share if active
        let mainVideo = null;
        let hasVideoContent = false;
        
        if (screenShared) {
            // If screen sharing is active, use screen share video
            mainVideo = document.querySelector('.screen-share-container video');
            if (mainVideo && mainVideo.srcObject) {
                hasVideoContent = true;
                console.log('PiP: Using screen share video');
            }
        }
        
        if (!mainVideo || !hasVideoContent) {
            // Try to get local video
            mainVideo = document.querySelector('#selfContainer video');
            if (mainVideo && mainVideo.srcObject) {
                const videoTrack = mainVideo.srcObject.getVideoTracks()[0];
                if (videoTrack && videoTrack.enabled) {
                    hasVideoContent = true;
                    console.log('PiP: Using local video');
                }
            }
        }
        
        if (!mainVideo || !hasVideoContent) {
            // Try to get any other participant video
            const participantVideos = document.querySelectorAll('.videoContainer:not(#selfContainer) video');
            for (let video of participantVideos) {
                if (video && video.srcObject) {
                    const videoTrack = video.srcObject.getVideoTracks()[0];
                    if (videoTrack && videoTrack.enabled) {
                        mainVideo = video;
                        hasVideoContent = true;
                        console.log('PiP: Using participant video');
                        break;
                    }
                }
            }
        }
        
        if (mainVideo && hasVideoContent) {
            console.log('PiP: Found video source with content');
            pipVideo.srcObject = mainVideo.srcObject;
            pipVideo.muted = true;
            
            // Ensure video plays
            pipVideo.onloadedmetadata = function() {
                pipVideo.play().catch(e => console.log('PiP video play failed:', e));
            };
            
            // Force play
            pipVideo.play().catch(e => console.log('PiP video play failed:', e));
        } else {
            console.log('PiP: No video source found, creating placeholder');
            // Create a placeholder or use canvas
            createPipPlaceholder();
        }
    }

    // Create PiP placeholder when no video is available
    function createPipPlaceholder() {
        if (!pipVideo) return;
        
        console.log('Creating PiP placeholder...');
        
        // Create a canvas with meeting info
        const canvas = document.createElement('canvas');
        canvas.width = 320;
        canvas.height = 240;
        const ctx = canvas.getContext('2d');
        
        // Fill background with gradient
        const gradient = ctx.createLinearGradient(0, 0, 0, 240);
        gradient.addColorStop(0, '#2c3e50');
        gradient.addColorStop(1, '#34495e');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 320, 240);
        
        // Add meeting info
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 18px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Meeting Active', 160, 80);
        
        ctx.font = '14px Arial';
        ctx.fillText('Camera is off', 160, 110);
        ctx.fillText('Click "Back to Tab"', 160, 140);
        ctx.fillText('to return to meeting', 160, 160);
        
        // Add meeting duration if available
        if (currentMeetingTime) {
            ctx.fillText(currentMeetingTime, 160, 190);
        }
        
        // Add icon
        ctx.fillStyle = '#3498db';
        ctx.font = '48px Arial';
        ctx.fillText('??', 160, 60);
        
        // Convert canvas to video stream
        try {
            const stream = canvas.captureStream();
            pipVideo.srcObject = stream;
            pipVideo.play().catch(e => console.log('PiP placeholder play failed:', e));
        } catch (error) {
            console.log('Canvas capture failed, using static image');
            // Fallback to static image if canvas capture fails
            pipVideo.style.background = 'linear-gradient(135deg, #2c3e50 0%, #34495e 100%)';
            pipVideo.style.display = 'flex';
            pipVideo.style.alignItems = 'center';
            pipVideo.style.justifyContent = 'center';
            pipVideo.style.color = 'white';
            pipVideo.style.fontSize = '16px';
            pipVideo.style.textAlign = 'center';
            pipVideo.innerHTML = `
                <div>
                    <div style="font-size: 24px; margin-bottom: 10px;">??</div>
                    <div style="font-weight: bold; margin-bottom: 5px;">Meeting Active</div>
                    <div style="margin-bottom: 5px;">Camera is off</div>
                    <div style="margin-bottom: 5px;">Click "Back to Tab"</div>
                    <div>to return to meeting</div>
                </div>
            `;
        }
    }

    // Start Picture-in-Picture
    function startPictureInPicture() {
        console.log('Starting Picture-in-Picture...');
        
        if (!pipVideo) {
            createPipVideoElement();
        }
        
        // Ensure PiP elements exist
        if (!pipVideo || !pipControls) {
            console.error('PiP elements not found, recreating...');
            createPipVideoElement();
        }
        
        // Show PiP window with proper positioning
        pipVideo.style.display = 'block';
        pipVideo.style.position = 'fixed';
        pipVideo.style.top = '20px';
        pipVideo.style.right = '20px';
        pipVideo.style.zIndex = '9999';
        
        pipControls.style.display = 'block';
        pipControls.style.position = 'fixed';
        pipControls.style.top = '20px';
        pipControls.style.right = '20px';
        pipControls.style.zIndex = '10000';
        
        isPipActive = true;
        
        // Update video source
        updatePipVideoSource();
        
        // Update button state
        $('#pictureInPicture').addClass('active').html('<i class="fa fa-arrow-left"></i>');
        
        // Show notification
        showPipNotification();
        
        // Start visibility check to ensure PiP stays visible
        startPipVisibilityCheck();
        
        console.log('PiP window shown at:', pipVideo.style.top, pipVideo.style.right);
        console.log('PiP video display:', pipVideo.style.display);
        console.log('PiP controls display:', pipControls.style.display);
    }

    // Start periodic check to ensure PiP window stays visible
    function startPipVisibilityCheck() {
        if (pipVisibilityCheckInterval) {
            clearInterval(pipVisibilityCheckInterval);
        }
        
        pipVisibilityCheckInterval = setInterval(() => {
            if (isPipActive && pipVideo && pipControls) {
                // Force visibility
                pipVideo.style.display = 'block';
                pipVideo.style.visibility = 'visible';
                pipVideo.style.opacity = '1';
                
                pipControls.style.display = 'block';
                pipControls.style.visibility = 'visible';
                pipControls.style.opacity = '1';
                
                // Ensure proper positioning
                pipVideo.style.position = 'fixed';
                pipVideo.style.top = '20px';
                pipVideo.style.right = '20px';
                pipVideo.style.zIndex = '9999';
                
                pipControls.style.position = 'fixed';
                pipControls.style.top = '20px';
                pipControls.style.right = '20px';
                pipControls.style.zIndex = '10000';
                
                // Update content periodically
                updatePipVideoSource();
            }
        }, 2000); // Check every 2 seconds
    }

    // Stop PiP visibility check
    function stopPipVisibilityCheck() {
        if (pipVisibilityCheckInterval) {
            clearInterval(pipVisibilityCheckInterval);
            pipVisibilityCheckInterval = null;
        }
    }

    // Show PiP notification
    function showPipNotification() {
        if (!('Notification' in window)) return;
        
        if (Notification.permission === 'granted') {
            new Notification('Meeting Active', {
                body: 'Click "Back to Tab" to return to meeting',
                icon: '/favicon.ico',
                tag: 'meeting-pip'
            });
        } else if (Notification.permission !== 'denied') {
            Notification.requestPermission().then(permission => {
                if (permission === 'granted') {
                    showPipNotification();
                }
            });
        }
    }

    // Maximize from PiP
    function maximizeFromPip() {
        if (!isPipActive) return;
        
        // Hide PiP
        hidePipWindow();
        
        // Focus on meeting tab
        window.focus();
        
        // Scroll to meeting area
        const meetingArea = document.querySelector('#videos') || document.body;
        meetingArea.scrollIntoView({ behavior: 'smooth' });
        
        // Update button state
        $('#pictureInPicture').removeClass('active').html('<i class="fa fa-external-link-alt"></i>');
        
        console.log('Maximized from PiP');
    }

    // Hide PiP window
    function hidePipWindow() {
        if (!pipVideo || !isPipActive) return;
        
        // Stop visibility check
        stopPipVisibilityCheck();
        
        pipVideo.style.display = 'none';
        pipControls.style.display = 'none';
        isPipActive = false;
        
        console.log('PiP window hidden');
    }

    // Toggle PiP camera
    function togglePipCamera() {
        if (localStream) {
            const videoTrack = localStream.getVideoTracks()[0];
            if (videoTrack) {
                if (videoMuted) {
                    videoTrack.enabled = true;
                    videoMuted = false;
                    $(this).html('<i class="fa fa-video"></i>');
                    showInfo(languages.camera_turned_on);
                } else {
                    videoTrack.enabled = false;
                    videoMuted = true;
                    $(this).html('<i class="fa fa-video-slash"></i>');
                    showInfo(languages.camera_turned_off);
                }
            }
        }
    }

    // Toggle PiP microphone
    function togglePipMic() {
        if (localStream) {
            const audioTrack = localStream.getAudioTracks()[0];
            if (audioTrack) {
                if (audioMuted) {
                    audioTrack.enabled = true;
                    audioMuted = false;
                    $(this).html('<i class="fa fa-microphone"></i>');
                    showInfo(languages.microphone_turned_on);
                } else {
                    audioTrack.enabled = false;
                    audioMuted = true;
                    $(this).html('<i class="fa fa-microphone-slash"></i>');
                    showInfo(languages.microphone_turned_off);
                }
            }
        }
    }

    // Clean up PiP
    function cleanupPip() {
        // Stop visibility check
        stopPipVisibilityCheck();
        
        if (pipVideo) {
            pipVideo.remove();
            pipVideo = null;
        }
        
        if (pipControls) {
            pipControls.remove();
            pipControls = null;
        }
        
        if (pipWindow) {
            pipWindow.close();
            pipWindow = null;
        }
        
        isPipActive = false;
        
        // Remove event listener
        window.removeEventListener('beforeunload', cleanupPip);
    }

    //toggle microphone
    $(document).on('click', '#toggleMic', function () {
        if (!featureAvailable('audio')) return;

        if (audioMuted) {
            unmuteAudio();
        } else {
            muteAudio();
        }
    });

    //toggle camera
    $(document).on('click', '#toggleVideo', function () {
        if (!featureAvailable('video')) return;

        if (videoMuted) {
            unmuteVideo();
        } else {
            muteVideo();
        }
    });

    // Mute audio function
    function muteAudio() {
        if (localStream) {
            const audioTrack = localStream.getAudioTracks()[0];
            if (audioTrack) {
                audioTrack.enabled = false;
                audioMuted = true;
                $('#toggleMic').html('<i class="fa fa-microphone-slash"></i>').addClass('btn-danger').removeClass('btn-primary');
                showInfo(languages.mic_mute);
            }
        }
    }

    // Unmute audio function
    function unmuteAudio() {
        if (localStream) {
            const audioTrack = localStream.getAudioTracks()[0];
            if (audioTrack) {
                audioTrack.enabled = true;
                audioMuted = false;
                $('#toggleMic').html('<i class="fa fa-microphone"></i>').removeClass('btn-danger').addClass('btn-primary');
                showInfo(languages.mic_unmute);
            }
        }
    }

    // Mute video function
    function muteVideo() {
        if (localStream) {
            const videoTrack = localStream.getVideoTracks()[0];
            if (videoTrack) {
                videoTrack.enabled = false;
                videoMuted = true;
                $('#toggleVideo').html('<i class="fa fa-video-slash"></i>').addClass('btn-danger').removeClass('btn-primary');
                showInfo(languages.camera_off);
                
                // Update PiP if active
                if (isPipActive) {
                    setTimeout(() => {
                        updatePipVideoSource();
                    }, 100);
                }
            }
        }
    }

    // Unmute video function
    function unmuteVideo() {
        if (localStream) {
            const videoTrack = localStream.getVideoTracks()[0];
            if (videoTrack) {
                videoTrack.enabled = true;
                videoMuted = false;
                $('#toggleVideo').html('<i class="fa fa-video"></i>').removeClass('btn-danger').addClass('btn-primary');
                showInfo(languages.camera_on);
                
                // Update PiP if active
                if (isPipActive) {
                    setTimeout(() => {
                        updatePipVideoSource();
                    }, 100);
                }
            }
        }
    }

    // Initialize button states based on current audio/video state
    function updateButtonStates() {
        // Add any additional logic you want to execute when button states are updated
        console.log('Button states updated');
    }
})();